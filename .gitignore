# ── Dependencies ──
node_modules/
**/node_modules/

# ── Build output ──
dist/
out/
**/out/
.webpack/
**/.webpack/
build/

# ── Electron Forge artifacts (also matched by out/) ──
*.dmg
*.zip
*.app

# ── OS ──
.DS_Store
Thumbs.db
ehthumbs.db
Desktop.ini

# ── Editors ──
.vscode/
.idea/
*.swp
*.swo
*~

# ── Logs ──
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*
electron-log/

# ── Secrets / API keys (defense in depth — keys actually live in electron-store
# outside the repo, but block common accidental-commit patterns anyway) ──
.env
.env.*
!.env.example
*.pem
*.key
*.p12
*.cer
*.crt
*.pfx
secrets/
credentials/
gateway-protocol-keys.json
**/gateway-protocol-keys.json
config.local.*

# ── Server deploy artifacts ──
# The hosted web app: a copy of electron-app/renderer/ synced into server/app
# at deploy time (npm run sync:app). Build artifact, never committed (avoids a
# 1 MB duplicate + drift). The renderer source-of-truth stays in electron-app/.
server/app/
# The .dmg dropped into server/download/ before `fly deploy` (already covered by
# *.dmg, but ignore the dir's contents too).
server/download/

# ── Runtime / cache ──
.cache/
*.tsbuildinfo

# ── Tests / coverage ──
coverage/
.nyc_output/
