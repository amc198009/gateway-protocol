# ── Dependencies ──
node_modules/
**/node_modules/

# ── Build output ──
dist/
out/
**/out/
.webpack/
**/.webpack/
build/

# ── Electron Forge artifacts (also matched by out/) ──
*.dmg
*.zip
*.app

# ── OS ──
.DS_Store
Thumbs.db
ehthumbs.db
Desktop.ini

# ── Editors ──
.vscode/
.idea/
*.swp
*.swo
*~

# ── Logs ──
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*
electron-log/

# ── Secrets / API keys (defense in depth — keys actually live in electron-store
# outside the repo, but block common accidental-commit patterns anyway) ──
.env
.env.*
!.env.example
*.pem
*.key
*.p12
*.cer
*.crt
*.pfx
secrets/
credentials/
gateway-protocol-keys.json
**/gateway-protocol-keys.json
config.local.*

# ── Runtime / cache ──
.cache/
*.tsbuildinfo

# ── Tests / coverage ──
coverage/
.nyc_output/
